[Unit]
Description=FLOP evidence scout — the agent daemon
Documentation=https://github.com/Mariukasfak/flop-evidence-scout
# Ollama is the local model the workload needs; without it the daemon runs but
# skips real inference (`skipped_no_real_model` in the log).
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
EnvironmentFile=-__APP_DIR__/.env.local
# These flags are the ones paleisti-nuolat.bat has always passed, and they are
# not decoration: without --data-dir the daemon resolves `data`, not
# `data/local`, and quietly starts from an empty state beside the real one.
# Measured on the first server boot 2026-09-04 — it ran for eleven minutes with
# the right identity and no memory of five completed contracts.
#
# --work-deadline-ms is this machine's own number, not a default worth copying.
# It was 8000 from 2026-09-04, to keep two shared vCPUs free for the kibble
# lanes — which then carried 455 of our 461 points. That premise died on
# 2026-09-05. The board's scorer is ~545,000 messages behind an /r/kibble whose
# ring retains 14,924 (1.59h at the board's current rate), so the messages
# between its cursor and the oldest retained line are deleted before it reads
# them. Twelve signed ATTESTs and 28 RESULTs of ours sat on that export while
# every scored term on both DIDs moved zero across 4.5 hours. The lane we were
# reserving CPU for cannot score, so it is not worth reserving CPU for.
#
# What the reservation cost is measurable, and it is the number this project
# actually lives on. Genuine inference receipts per day: 23,179 (09-01), 18,140
# (09-02), 20,445 (09-03) — then 4,293 on 09-04 and ~2,760/day since, a 7x
# collapse across the same day this cap and the 2-vCPU box arrived. The
# workload runner asks for 20 sessions a cycle and gets 1.86: 1,033 of 11,123
# planned over 12 hours, 9.3%. The teaser scores an agent's allocation largely
# on testnet FLOP spent on inference, so throughput is the whole preparation.
#
# 25000 because a classify-size request costs 2.1s unloaded and 6.8s under
# load, so this budget buys 4-6 sessions rather than 2. It lengthens the cycle
# (71.5s median today against a 60s interval) and that is accepted: nothing
# time-critical rides the cycle. Faucet detection is a separate 15-minute
# GitHub Actions run, not this loop.
ExecStart=/usr/bin/node src/daemon.mjs --url=https://technocore.chat --interval-ms=60000 --work-deadline-ms=25000 --data-dir=data/local --docs-dir=data/local/docs

# The daemon already restarts itself after a code change; this covers the rest
# — a crash, an OOM kill, a reboot. RestartSec is deliberately longer than the
# lease renewal so a crash loop cannot thrash the lease.
Restart=always
RestartSec=20s

# Long enough for the daemon to finish the cycle it is in and hand the lease
# back. systemd's default is 90s; a cycle on this box runs 100–125s, so a stop
# during one was killed before it could release, and the next start then sat
# out the remaining nine minutes of a lease it already owned. Measured that way
# on 2026-09-04. It matters more now that the update timer restarts the agent
# on its own: a deploy that costs nine idle minutes is a deploy nobody wants.
TimeoutStopSec=180

# Journald keeps the console log; the file mirror in data/local stays too.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=triagent

# The model is the memory hog (~2.3 GB loaded), the daemon itself ~0.5 GB.
# On a 4 GB box this ceiling stops a leak from taking the whole machine with it.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
