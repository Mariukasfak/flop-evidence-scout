[Unit]
Description=FLOP evidence scout — the agent daemon
Documentation=https://github.com/Mariukasfak/flop-evidence-scout
# Ollama is the local model the workload needs; without it the daemon runs but
# skips real inference (`skipped_no_real_model` in the log).
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
EnvironmentFile=-__APP_DIR__/.env.local
# These flags are the ones paleisti-nuolat.bat has always passed, and they are
# not decoration: without --data-dir the daemon resolves `data`, not
# `data/local`, and quietly starts from an empty state beside the real one.
# Measured on the first server boot 2026-09-04 — it ran for eleven minutes with
# the right identity and no memory of five completed contracts.
ExecStart=/usr/bin/node src/daemon.mjs --url=https://technocore.chat --interval-ms=60000 --data-dir=data/local --docs-dir=data/local/docs

# The daemon already restarts itself after a code change; this covers the rest
# — a crash, an OOM kill, a reboot. RestartSec is deliberately longer than the
# lease renewal so a crash loop cannot thrash the lease.
Restart=always
RestartSec=20s

# Long enough for the daemon to finish the cycle it is in and hand the lease
# back. systemd's default is 90s; a cycle on this box runs 100–125s, so a stop
# during one was killed before it could release, and the next start then sat
# out the remaining nine minutes of a lease it already owned. Measured that way
# on 2026-09-04. It matters more now that the update timer restarts the agent
# on its own: a deploy that costs nine idle minutes is a deploy nobody wants.
TimeoutStopSec=180

# Journald keeps the console log; the file mirror in data/local stays too.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=triagent

# The model is the memory hog (~2.3 GB loaded), the daemon itself ~0.5 GB.
# On a 4 GB box this ceiling stops a leak from taking the whole machine with it.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
