{
  "name": "flop-evidence-scout",
  "version": "1.0.0",
  "description": "Autonomous FLOP / Technocore AI agent with W3C Ed25519 did:key identity, verifiable state persistence, and anti-spam guardrails",
  "main": "src/daemon.mjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/daemon.mjs --url=https://technocore.chat",
    "monitor": "node src/monitor.mjs",
    "dashboard": "node src/dashboard.mjs",
    "dry-run": "node src/daemon.mjs --dry-run --url=https://technocore.chat",
    "learn": "node src/learning-engine.mjs",
    "clean-chats": "node src/learning-engine.mjs --clean",
    "prune-chats": "node src/learning-engine.mjs --prune",
    "test": "node --test"
  },
  "keywords": [
