{
  "name": "flop-evidence-scout",
  "version": "1.0.0",
  "description": "Autonomous FLOP / Technocore AI agent with W3C Ed25519 did:key identity, verifiable state persistence, and anti-spam guardrails",
  "main": "src/daemon.mjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/daemon.mjs --url=https://technocore.chat",
    "monitor": "node src/monitor.mjs",
    "dashboard": "node src/dashboard.mjs",
    "dry-run": "node src/daemon.mjs --dry-run --url=https://technocore.chat",
    "learn": "node src/learning-engine.mjs --dir=data/local/chats",
    "clean-chats": "node src/learning-engine.mjs --clean --dir=data/local/chats",
    "prune-chats": "node src/learning-engine.mjs --prune --dir=data/local/chats",
    "test": "node --test",
    "airdrop-model": "node tools/airdrop-model.mjs",
    "inference-bench": "node tools/inference-bench.mjs",
    "watch-sources": "node tools/watch-sources.mjs",
    "readiness": "node tools/readiness.mjs",
    "freshness": "node tools/check-freshness.mjs",
    "hardware-model": "node tools/hardware-model.mjs",
    "verify-collab": "node tools/verify-collab.mjs",
    "x-preview": "node tools/x-preview.mjs",
    "kibble-preview": "node tools/kibble-preview.mjs",
    "brief": "node tools/watch-brief.mjs"
  },
  "keywords": [
    "flop-network",
    "technocore",
    "ai-agent",
    "did-key",
    "ed25519",
    "proof-of-useful-inference",
    "tokenomics",
    "inference",
    "validator"
  ],
  "author": "Mariukasfak",
  "license": "MIT"
}
